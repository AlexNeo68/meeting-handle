# Пример переменных окружения для API. Скопируй в `.env` (apps/api/.env) и заполни своими значениями.

# PostgreSQL connection string. Обязательна — без неё API не стартует.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meeting_ai"

# Секрет для подписи JWT. Обязателен и должен быть НЕ короче 32 символов
# (fail-fast при старте). В prod — длинная случайная строка, не коммить в репозиторий.
JWT_SECRET="change-me-to-a-random-string-at-least-32-chars"

# Порт, на котором слушает API (web проксирует сюда через rewrites). Дефолт: 3001.
PORT=3001

# Разрешённые origins для CORS (через запятую). Дефолт: localhost:3000 (dev).
# В prod — публичный origin web-приложения. Не используй "*".
CORS_ORIGINS="https://example.com"

# Rate limit (ThrottlerModule):
# - register/login — per IP,
# - PATCH /user/password — per user+IP (лимит зафиксирован @Throttle: 5/15мин).
# Окно лимита в мс (дефолт: 900000 = 15 мин).
THROTTLE_TTL_MS=900000
# Максимум попыток за окно (дефолт: 5).
THROTTLE_LIMIT=5

# Хопы reverse proxy — кол-во прокси перед API (`app.set('trust proxy', ...)`), см. docs/deployment.md.
# - 0 (или не задан): API доступен напрямую, trust proxy выключен. X-Forwarded-For игнорируется.
# - 1+: API стоит за одним/несколькими прокси (Next.js rewrite, nginx, ALB и т.п.) —
#   Express берёт реальный IP клиента из X-Forwarded-For, IP-компонента rate limit корректна.
# В текущей топологии (web → rewrite /api/* → :3001) ставь 1.
TRUST_PROXY_HOPS=1
