{
  "name": "meeting-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Meeting AI — monorepo with Next.js frontend and NestJS backend",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build:shared && npm run build -w apps/web && npm run build -w apps/api",
    "build:shared": "npm run build -w @meeting-ai/shared",
    "build:web": "npm run build -w apps/web",
    "build:api": "npm run build -w apps/api",
    "lint": "eslint \"apps/**/*.{ts,tsx}\"",
    "format": "prettier --write \"apps/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,json,md}\"",
    "test": "npm run test -w @meeting-ai/shared && npm run test -w apps/web && npm run test -w apps/api",
    "test:shared": "npm run test -w @meeting-ai/shared",
    "test:web": "npm run test -w apps/web",
    "test:api": "npm run test -w apps/api",
    "test:e2e": "npm run test:e2e:api && npm run test:e2e:web",
    "test:e2e:api": "npm run test:e2e -w apps/api",
    "test:e2e:web": "playwright test",
    "prepare": "husky && npm run build:shared"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.1.7",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
